{
  "name": "midi-preset-studio",
  "version": "1.0.0",
  "description": "MIDI Preset Studio – offline-first preset editor, Akai MPD24 adapter",
  "main": "out/main/index.js",
  "author": "SiCKaRiM",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "rebuild": "electron-rebuild -f -w midi",
    "build:mac": "npm run build && electron-builder --mac --universal"
  },
  "dependencies": {
    "jzz": "^1.9.6",
    "jzz-midi-smf": "^1.9.9",
    "midi": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "de.sickarim.midipresetstudio",
    "productName": "MIDI Preset Studio",
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist"
    }
  }
}
